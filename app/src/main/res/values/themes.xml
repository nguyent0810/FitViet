<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1 is dark-theme only per design tokens; base on an AppCompat parent (not
         Theme.Material3.*, which needs the separate com.google.android.material Views library
         this Compose-only app doesn't depend on) regardless of system setting. MainActivity is
         an AppCompatActivity, so this parent matches its actual activity base class. -->
    <style name="Theme.FitViet" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/app_canvas</item>
        <item name="android:statusBarColor">@color/app_canvas</item>
        <item name="android:navigationBarColor">@color/app_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
